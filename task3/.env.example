# ---------------------------------------------------------------------------
# Copy this file to .env before running the project:
#   cp .env.example .env
# .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Used when running the API on your machine and Postgres in Docker:
#   docker compose up -d db && npm start
DATABASE_URL=postgres://postgres:dev@localhost:5432/tasks

# Used by docker compose to create the database and to build the in-network
# connection string for the api service (host = db, not localhost).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
POSTGRES_DB=tasks
POSTGRES_PORT=5432

# Host port for the API.
PORT=3000
