# Runtime
PORT=3000
DATABASE_PATH=./data/social-studio.db

# Active platforms. Each platform generates one variant.
# Allowed: x, linkedin, telegram, discord, mastodon
PLATFORMS=x,linkedin

# Adapter per platform. Swap this to change transport without touching business logic.
ADAPTER_X=mock_x
ADAPTER_LINKEDIN=mock_linkedin
ADAPTER_TELEGRAM=telegram
ADAPTER_DISCORD=discord
ADAPTER_MASTODON=mastodon

# Real target: Telegram (leave blank to use only the mock adapters)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Other real adapters, also optional
DISCORD_WEBHOOK_URL=
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Worker
WORKER_ENABLED=true
WORKER_INTERVAL_MS=1000
LEASE_MS=60000
MAX_ATTEMPTS=3
