{
  "name": "flyrank-capstone-social-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Social Media Studio: ingest one blog post, generate platform variants, review them, and publish approved variants exactly once through a durable scheduler.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker-cli.js",
    "worker:tick": "node src/tick.js",
    "seed": "node src/seed.js",
    "test": "node --test",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "capstone",
    "social-media",
    "adapters",
    "idempotency",
    "scheduler",
    "sqlite"
  ],
  "author": "Mohammed Soliman",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
